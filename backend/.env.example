MONGODB_URI=mongodb://127.0.0.1:27017/kirana-mart
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/kirana-mart
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Razorpay Dashboard -> Webhooks. Never reuse the API key secret here.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

ADMIN_NAME=Store Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_me
